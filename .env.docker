# Docker Environment Variables
# Copy to .env and adjust for your environment

# ==================== POSTGRESQL ====================
DB_USER=baby_john_user
DB_PASSWORD=baby_john_password
DB_NAME=baby_john_db
DB_PORT=5432

# ==================== DATABASE URL ====================
DATABASE_URL=postgresql+psycopg://baby_john_user:baby_john_password@postgres:5432/baby_john_db

# ==================== FASTAPI ====================
SECRET_KEY=your-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
DEBUG=False
LOG_LEVEL=INFO

# ==================== API ====================
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# ==================== PGADMIN ====================
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# ==================== COMPOSE ====================
COMPOSE_PROJECT_NAME=baby_john
