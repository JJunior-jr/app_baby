# Production Environment Variables
# IMPORTANT: Change all values before deploying to production

# ==================== DATABASE ====================
DATABASE_URL=postgresql+psycopg://baby_john_user:CHANGE_THIS_PASSWORD@postgres:5432/baby_john_db
DB_USER=baby_john_user
DB_PASSWORD=CHANGE_THIS_PASSWORD
DB_NAME=baby_john_db
DB_PORT=5432

# ==================== FASTAPI ====================
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_STRING_AT_LEAST_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
DEBUG=False
LOG_LEVEL=INFO

# ==================== API ====================
API_PORT=8000
CORS_ORIGINS=["https://yourdomain.com","https://www.yourdomain.com"]

# ==================== PGADMIN ====================
PGADMIN_EMAIL=admin@yourdomain.com
PGADMIN_PASSWORD=CHANGE_THIS_PASSWORD
PGADMIN_PORT=5050

# ==================== COMPOSE ====================
COMPOSE_PROJECT_NAME=baby_john_prod

# ==================== NGINX ====================
# SSL certificate paths (mount in docker-compose.prod.yml)
# SSL_CERT=/etc/nginx/ssl/cert.pem
# SSL_KEY=/etc/nginx/ssl/key.pem

# ==================== DATABASE POOL ====================
DB_POOL_SIZE=50
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# ==================== SECURITY ====================
SECURE_COOKIES=True
SSL_VERIFY=True
