# Backend Environment Variables Template
# Copy to .env and adjust for your environment

# ==================== DATABASE ====================
# PostgreSQL connection string
# Format: postgresql+psycopg://user:password@host:port/database
DATABASE_URL=postgresql+psycopg://baby_john_user:baby_john_password@localhost:5432/baby_john_db

# ==================== JWT & AUTHENTICATION ====================
# Secret key for JWT signing - Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ==================== FASTAPI ====================
DEBUG=False
LOG_LEVEL=INFO
API_TITLE=Baby John API
API_VERSION=1.0.0

# ==================== CORS ====================
# Comma-separated list or JSON array of allowed origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ==================== RATE LIMITING ====================
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_PERIOD=60

# ==================== DATABASE POOL ====================
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600
DB_ECHO=False

# ==================== LOGGING ====================
LOG_FORMAT=json
LOG_FILE=/var/log/baby-john-api.log

# ==================== FEATURES ====================
ENABLE_OFFLINE_SYNC=True
ENABLE_FEEDBACK_SYSTEM=True
ENABLE_CALENDAR_SYNC=False

# ==================== SECURITY ====================
# HTTPS/SSL
SSL_VERIFY=True
SECURE_COOKIES=False  # Set to True in production with HTTPS

# ==================== PROFILING & MONITORING ====================
ENABLE_PROFILING=False
ENABLE_METRICS=True
SENTRY_DSN=  # Optional: Sentry error tracking
